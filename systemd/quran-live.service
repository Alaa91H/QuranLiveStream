[Unit]
Description=QuranLiveStream Universal Native Multi-Platform Broadcaster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@QURAN_HOME@
EnvironmentFile=-@QURAN_HOME@/.env
ExecStart=@QURAN_HOME@/scripts/stream_multi.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
Nice=-2
OOMScoreAdjust=-200
CPUAccounting=true
MemoryAccounting=true
CPUQuota=@CPU_QUOTA@
MemoryHigh=88%
MemoryMax=94%
TasksMax=384
StandardOutput=append:@QURAN_HOME@/logs/systemd_stream.log
StandardError=append:@QURAN_HOME@/logs/systemd_stream.log

[Install]
WantedBy=default.target
