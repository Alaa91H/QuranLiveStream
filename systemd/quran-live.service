[Unit]
Description=QuranLiveStream Universal Native Multi-Platform Broadcaster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@QURAN_HOME@
EnvironmentFile=-@QURAN_HOME@/.env
ExecStart=@QURAN_HOME@/scripts/stream_multi.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
# This is intentionally a user unit. Negative Nice/OOMScoreAdjust values need
# privileges or resource limits that ordinary VPS user managers do not have.
# CPU/memory safety and prioritization are enforced portably by the cgroup
# envelope below plus the live resource governor.
Nice=0
OOMScoreAdjust=0
CPUAccounting=true
MemoryAccounting=true
CPUQuota=@CPU_QUOTA@
MemoryHigh=88%
MemoryMax=94%
TasksMax=384
StandardOutput=append:@QURAN_HOME@/logs/systemd_stream.log
StandardError=append:@QURAN_HOME@/logs/systemd_stream.log

[Install]
WantedBy=default.target
