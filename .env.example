# ==============================================================================
# QuranLiveStream — universal native multi-platform configuration
# Copy to .env, chmod 600 .env, configure ONLY destinations you will use.
# ==============================================================================

# Only these destinations are published. Runtime override:
#   ./scripts/control.sh start youtube,tiktok
STREAM_TARGETS=youtube

# auto = benchmark/governor decides the highest sustainable quality.
# Any explicit profile is a CEILING only; it never forces weak hardware upward.
# nano|micro|eco|balanced|high|ultra|extreme
STREAM_PROFILE=auto

# auto: weak/normal servers share compatible encoders; strong verified hardware
# may split same-aspect targets so each platform receives its highest quality.
# efficient: always share compatible aspect+codec outputs where possible.
# maximize: split by platform quality ceiling (needs more CPU/GPU/RAM).
QUALITY_POLICY=auto

# --- Platform credentials -------------------------------------------------------
# Either complete private ingest URL, or base URL + key. Never commit real keys.
YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com/live2
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

TIKTOK_RTMP_URL=
TIKTOK_STREAM_KEY=

FACEBOOK_RTMP_URL=
FACEBOOK_STREAM_KEY=

TWITCH_RTMP_URL=
TWITCH_STREAM_KEY=
# Twitch 1440p Enhanced Broadcasting varies by account/support. Opt-in only:
TWITCH_ALLOW_1440P=0

KICK_RTMP_URL=
KICK_STREAM_KEY=

# Arbitrary RTMP/RTMPS destination:
# CUSTOM1_RTMP_TARGET=rtmps://example.com/app/secret-key

# --- Exact native platform canvas overrides ------------------------------------
# Defaults: YouTube/Facebook/Twitch/Kick/custom = landscape 16:9;
# TikTok/Instagram/Reels/Shorts = portrait 9:16.
# The browser/Xvfb/encoder use the SAME final dimensions: no scale/crop/pad.
# TIKTOK_LAYOUT=portrait
# YOUTUBE_LAYOUT=landscape
# CUSTOM1_LAYOUT=square
#
# Per-platform quality/capability overrides (optional):
# YOUTUBE_MAX_PROFILE=ultra
# TIKTOK_MAX_PROFILE=balanced
# CUSTOM1_MAX_PROFILE=extreme
# CUSTOM1_MAX_FPS=60
# CUSTOM1_MAX_VIDEO_BITRATE=12000k
# CUSTOM1_MAX_AUDIO_BITRATE=160k
# CUSTOM1_VIDEO_CODEC=h264

# --- Live resource governor -----------------------------------------------------
# Runtime target stays well below 90%; the cgroup safety guard defaults to 90%
# aggregate CPU and 94% memory. Hard governor threshold is deliberately lower.
RESOURCE_GOVERNOR=1
RESOURCE_INTERVAL_SEC=10
RESOURCE_CPU_SOFT=78
RESOURCE_CPU_HARD=88
RESOURCE_RAM_SOFT=82
RESOURCE_RAM_HARD=89
RESOURCE_HIGH_HITS=3
RESOURCE_CPU_LOW=52
RESOURCE_RAM_LOW=68
RESOURCE_LOW_HITS=60
RESOURCE_COOLDOWN_SEC=240
RESOURCE_AUTO_UPGRADE=1
RESOURCE_SPEED_SOFT=0.97
# Final systemd aggregate CPU guard. 90 means 90% of total host CPU capacity.
SYSTEMD_CPU_HARD_PCT=90

# --- Network guard --------------------------------------------------------------
# probe_egress.sh measures a conservative uplink ceiling. Total safe egress is
# divided across every selected destination automatically.
EGRESS_GUARD=1
RTMP_PREFLIGHT_STRICT=0

# --- Audio ----------------------------------------------------------------------
# The visible master browser owns recitation timing. It prefers local MP3 files
# automatically and falls back to the CDN when needed; FFmpeg captures the same
# browser timeline through quran_sink so every platform stays verse-synchronized.
AUDIO_MODE=pulse
AUDIO_CHANNELS=1
# AUDIO_BITRATE=64k
# Optional local audio caching must never fill the filesystem. Runtime per-ayah
# caching stops below this free-space floor and transparently keeps using CDN.
AUDIO_CACHE_MIN_FREE_MB=768
# Full-corpus primer (~3.5GB actual) uses a conservative estimate + reserve.
AUDIO_PRIME_EST_MB=3800
AUDIO_PRIME_RESERVE_MB=768

# --- Browser / UI ---------------------------------------------------------------
PRIME_STATIC=1
PRIME_AUDIO=1
# Bounded in-memory API cache; long-lived entries are still persisted on disk.
CACHE_MAX_ENTRIES=512
# CHROME_BIN=/usr/bin/chromium
QURAN_WEB_PORT=4177
# Native multi-layout displays start at :90, :91, :92...
QURAN_DISPLAY_BASE=90

# --- Hardware encoding ----------------------------------------------------------
# NVENC is used only after an actual smoke test passes. VAAPI remains opt-in
# because cloud/driver X11 chains differ across hosts.
HW_ALLOW_EXPERIMENTAL=0

# --- Monitoring / notifications -------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional Quran Foundation API ---------------------------------------------
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_EN_TAFSIR_ID=169
QF_AR_TAFSIR_ID=
PRAYER_METHOD=3
