# ==============================================================================
# Quran Live Stream — Universal Adaptive Configuration
# Copy to .env and fill only the platforms you actually want to use.
# NEVER commit real stream keys.
# ==============================================================================

# --- Select platforms ---------------------------------------------------------
# ONLY listed platforms are published. One render + one encode is shared to all
# selected destinations whenever they use the same broadcast canvas.
STREAM_TARGETS=youtube

# Built-in/common destinations
YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com/live2
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

TIKTOK_RTMP_URL=rtmp://rtmp.tiktok.com/live
TIKTOK_STREAM_KEY=

FACEBOOK_RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp
FACEBOOK_STREAM_KEY=

TWITCH_RTMP_URL=rtmp://live.twitch.tv/app
TWITCH_STREAM_KEY=

# Kick endpoints vary by account/region; paste the exact server shown by Kick.
KICK_RTMP_URL=
KICK_STREAM_KEY=

# Any platform is supported. Add its slug to STREAM_TARGETS and define variables
# using the upper-case slug. Example: STREAM_TARGETS=youtube,myplatform
MYPLATFORM_RTMP_URL=
MYPLATFORM_STREAM_KEY=

# --- Adaptive resource governor ----------------------------------------------
# The engine starts from hardware_profile.sh / benchmark_host.sh and changes
# quality only when real runtime telemetry requires it.
ADAPTIVE_ENABLE=1
ADAPTIVE_UPSHIFT=1
CPU_TARGET=80
CPU_HARD_LIMIT=90
RAM_TARGET=82
RAM_HARD_LIMIT=90
ADAPTIVE_SAMPLE_SEC=5
ADAPTIVE_OVERLOAD_SAMPLES=3
ADAPTIVE_UNDERLOAD_SAMPLES=24
ADAPTIVE_COOLDOWN_SEC=180
FFMPEG_MIN_SPEED=0.97

# Optional hard quality ceiling. Leave blank for full auto-detection.
# STREAM_PROFILE=micro
# STREAM_RES=720p

# Optional manual rate overrides; normally leave unset for adaptive profiles.
# VIDEO_BITRATE=1200k
# AUDIO_BITRATE=96k
# STREAM_FPS=15

# --- Audio -------------------------------------------------------------------
# micro/nano default to file mode to remove PulseAudio from the hot path.
# Run scripts/download_all_recitations.sh before using file mode for full Quran.
# AUDIO_MODE=file
# AUDIO_MODE=pulse
# AUDIO_CHANNELS=1

# --- Cache / first boot -------------------------------------------------------
PRIME_STATIC=1
PRIME_AUDIO=1
# HOST_AUTO_PROFILE=0
# HOST_BENCH_PROFILE=micro
# EGRESS_GUARD=1

# --- Monitoring ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SPEED_MIN=0.8
# SPEED_HITS=3
# SPEED_MONITOR=1

# --- Hardware encode ----------------------------------------------------------
# NVENC is automatically used only after the existing preflight smoke-test path.
# VAAPI/QSV remain experimental on heterogeneous cloud hosts.
# HW_ALLOW_EXPERIMENTAL=1
# CHROME_BIN=/usr/bin/chromium

# --- Quran APIs ---------------------------------------------------------------
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_EN_TAFSIR_ID=169
QF_AR_TAFSIR_ID=
PRAYER_METHOD=3
