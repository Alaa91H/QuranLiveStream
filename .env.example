# ==============================================================================
# QuranLiveStream — universal multi-platform configuration
# Copy to .env, chmod 600 .env, then configure only the platforms you use.
# ==============================================================================

# Comma-separated destinations. Only these are published.
# Runtime alternative: ./scripts/control.sh start youtube,tiktok
STREAM_TARGETS=youtube

# auto = portrait only when ALL selected targets are vertical-first platforms
# (tiktok/instagram/reels/shorts); otherwise landscape. Override if desired.
STREAM_LAYOUT=auto

# Leave empty for benchmark + live resource-governor selection.
# Optional ceiling/starting hint: nano|micro|eco|balanced|high|ultra|extreme
STREAM_PROFILE=

# --- Platform credentials -------------------------------------------------------
# Either set NAME_RTMP_TARGET to a complete private ingest URL, OR use
# NAME_RTMP_URL + NAME_STREAM_KEY. Never commit real keys.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
# YOUTUBE_MAX_VIDEO_BITRATE=6000k

TIKTOK_RTMP_URL=
TIKTOK_STREAM_KEY=
# TIKTOK_MAX_VIDEO_BITRATE=4500k

FACEBOOK_RTMP_URL=
FACEBOOK_STREAM_KEY=

TWITCH_RTMP_URL=
TWITCH_STREAM_KEY=
# TWITCH_MAX_VIDEO_BITRATE=6000k

KICK_RTMP_URL=
KICK_STREAM_KEY=

# Arbitrary RTMP/RTMPS service — add any name, then select it in STREAM_TARGETS.
# CUSTOM1_RTMP_TARGET=rtmps://example.com/app/secret-key
# CUSTOM1_MAX_VIDEO_BITRATE=4000k

# --- Live resource governor -----------------------------------------------------
# Goal: prevent sustained overload. Instantaneous spikes can still occur, but
# the governor samples every 15s, downgrades after sustained pressure, and never
# auto-upgrades above the measured benchmark ceiling.
RESOURCE_GOVERNOR=1
RESOURCE_INTERVAL_SEC=15
RESOURCE_CPU_SOFT=85
RESOURCE_CPU_HARD=93
RESOURCE_RAM_SOFT=88
RESOURCE_RAM_HARD=94
RESOURCE_HIGH_HITS=3
RESOURCE_CPU_LOW=55
RESOURCE_RAM_LOW=70
RESOURCE_LOW_HITS=80
RESOURCE_COOLDOWN_SEC=300
RESOURCE_STARTUP_GRACE_SEC=90
RESOURCE_AUTO_UPGRADE=1
RESOURCE_SPEED_SOFT=0.95
# RESOURCE_MAX_PROFILE=eco

# --- Network guard --------------------------------------------------------------
# probe_egress.sh measures a safe 24/7 uplink ceiling. With multiple selected
# targets, stream_multi divides that budget across all outputs automatically.
EGRESS_GUARD=1
RTMP_PREFLIGHT_STRICT=0

# --- Audio ----------------------------------------------------------------------
# micro/nano favor file mode after local recitation has been prepared.
# file = local MP3 concat, very low CPU; pulse = browser audio capture.
AUDIO_MODE=file
AUDIO_CHANNELS=1
# AUDIO_BITRATE=64k
FILE_AUDIO_MIN_COUNT=2000

# --- Browser / UI ---------------------------------------------------------------
PRIME_STATIC=1
PRIME_AUDIO=1
# CHROME_BIN=/usr/bin/chromium
QURAN_WEB_PORT=4177
QURAN_DISPLAY=99

# --- Hardware encoding ----------------------------------------------------------
# NVENC is used automatically only after a successful smoke test.
# VAAPI stays opt-in because X11/color chains vary by host.
HW_ALLOW_EXPERIMENTAL=0

# --- Monitoring / notifications -------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional Quran Foundation API ---------------------------------------------
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_EN_TAFSIR_ID=169
QF_AR_TAFSIR_ID=
PRAYER_METHOD=3
